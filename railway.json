{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "npm run db:migrate:deploy && npm run db:seed && npm start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300
  }
}
