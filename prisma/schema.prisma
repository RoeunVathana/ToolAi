generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  projects     VideoProject[]
  voiceNarrations VoiceNarration[]
  voiceTimelines VoiceTimeline[]
  publishJobs   PublishJob[]
}

model VideoProject {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  title           String
  topic           String
  language        String       @default("km")
  durationMinutes Int          @default(1)
  script          String       @db.Text
  status          String       @default("DRAFT")
  aspectRatio     String       @default("16:9")
  resolution      String       @default("1280x720")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAssets     MediaAsset[]
  renderJobs      RenderJob[]
  voiceNarrations VoiceNarration[]
  voiceTimelines  VoiceTimeline[]
  publishJobs     PublishJob[]

  @@index([userId, updatedAt])
}

model VoiceNarration {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  projectId       String?       @db.Uuid
  title           String
  script          String        @db.Text
  voice           String
  speed           Float         @default(1.0)
  provider        String
  model           String?
  mode            String        @default("TTS")
  status          String        @default("COMPLETED")
  storagePath     String
  mimeType        String        @default("audio/wav")
  size            Int
  durationSeconds Float?
  errorMessage    String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         VideoProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model VoiceTimeline {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  projectId       String?       @db.Uuid
  title           String
  voice           String
  sourcePath      String
  audioPath       String?
  subtitlePath    String?
  outputPath      String?
  subtitleText    String        @db.Text
  status          String        @default("COMPLETED")
  durationSeconds Float?
  errorMessage    String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         VideoProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model MediaAsset {
  id           String       @id @default(uuid()) @db.Uuid
  projectId    String       @db.Uuid
  type         String
  filename     String
  storagePath  String
  mimeType     String
  size         Int
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  project      VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type, displayOrder])
}

model RenderJob {
  id           String       @id @default(uuid()) @db.Uuid
  projectId    String       @db.Uuid
  status       String       @default("QUEUED")
  progress     Int          @default(0)
  outputPath   String?
  errorMessage String?      @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model PublishJob {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  projectId      String        @db.Uuid
  platform       String
  status         String        @default("PENDING_APPROVAL")
  title          String
  description    String        @db.Text
  tags           String?       @db.Text
  privacyStatus  String        @default("private")
  scheduledAt    DateTime?
  timezone       String        @default("Asia/Phnom_Penh")
  rightsVerified Boolean       @default(false)
  approvedAt     DateTime?
  publishedUrl   String?
  errorMessage   String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt])
  @@index([projectId, platform, createdAt])
}
