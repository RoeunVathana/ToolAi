{
  "name": "toolaime-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "build": "vite build",
    "start": "npm run db:migrate:deploy && npm run db:seed && npm run start:app",
    "start:app": "node server/index.js",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name phase1_initial",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:phase1": "node --test tests/phase1.test.js"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "googleapis": "^150.0.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.77.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "prisma": "^6.19.0",
    "vite": "^7.1.7"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
